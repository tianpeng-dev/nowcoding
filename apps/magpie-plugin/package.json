{
  "name": "magpie-nowcoding",
  "version": "0.1.0",
  "description": "Local AI coding activity, device sync and public profile cards for Magpie.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "files": ["dist", "page", "ui", "LICENSE", "README.md"],
  "engines": {
    "magpie": ">=0.1.4079"
  },
  "magpie": {
    "name": "NowCoding",
    "page": {
      "title": "NowCoding",
      "file": "page/index.html",
      "service": {
        "port": 37481,
        "option": "port"
      }
    },
    "permissions": [],
    "options": {
      "port": 37481
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nowcoding/collector": "workspace:*",
    "@nowcoding/core": "workspace:*",
    "@nowcoding/parsers": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  }
}
