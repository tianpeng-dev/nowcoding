{
  "name": "@nowcoding/core",
  "version": "0.0.0",
  "private": false,
  "description": "Shared NowCoding schemas, aggregation helpers, privacy rules, and Cloud protocol types.",
  "license": "MIT",
  "homepage": "https://github.com/tianpeng-dev/nowcoding#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianpeng-dev/nowcoding.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/tianpeng-dev/nowcoding/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./privacy": "./src/privacy.ts",
    "./aggregator": "./src/aggregator.ts",
    "./extractor": "./src/extractor.ts",
    "./streak": "./src/streak.ts",
    "./heatmap": "./src/heatmap.ts",
    "./cost": "./src/cost.ts",
    "./activity": "./src/activity.ts",
    "./engagement": "./src/engagement.ts",
    "./token": "./src/token.ts",
    "./cloud": "./src/cloud.ts",
    "./types": "./src/types.ts",
    "./schemas": "./src/schemas.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/core/tests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
