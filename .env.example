# Required: Postgres. For NowCoding Cloud, use the Supabase transaction pooler
# URL from Project Settings > Database.
DATABASE_URL=postgresql://postgres.<project-ref>:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_MAX_CONNECTIONS=1

# Optional: Supabase Cloud/Auth settings for the hosted V2 path. Do not expose
# service-role keys to browser code.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required: Public identity (single-tenant deployment)
NOWCODING_USERNAME=alice
NOWCODING_API_TOKEN=

# Optional: Profile metadata
NOWCODING_GITHUB_HANDLE=
NOWCODING_DISPLAY_NAME=
NOWCODING_BIO=
NOWCODING_WEBSITE_URL=
NOWCODING_LOCATION=
NOWCODING_TIMEZONE=UTC

# Optional: Privacy controls. Project names are hidden by default; hostname,
# estimated cost, and live status are public unless disabled.
NOWCODING_UPLOAD_PROJECT=false
NOWCODING_UPLOAD_HOSTNAME=true
NOWCODING_SHOW_COST=true
NOWCODING_SHOW_LIVE=true

# Required in production: strong random secret for Vercel Cron Authorization
CRON_SECRET=
